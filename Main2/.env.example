# =====================================================================================
#  TriageMate keys.  Copy this file to  .env  and paste each key AFTER the "=" on its line. Leave a line empty if you don't have that key.
#  You can keep ALL your keys here at the same time. Only the provider named in LLM_PROVIDER is used.
# =====================================================================================

# ---- WHICH PROVIDER TO USE  (openai | apertus | azure | anthropic | local | none) ------------------
LLM_PROVIDER=openai

# ---- OPTIONAL: different provider per job (plan: OpenAI for classification, Apertus for drafting) ---
# Leave blank to use LLM_PROVIDER for everything.
CLASSIFY_PROVIDER=
DRAFT_PROVIDER=

# ---- 1) OpenAI --------------------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# ---- 2) Swisscom Apertus (Swiss AI Platform) - key from "The Keymaker" portal ---------------------------
APERTUS_API_KEY=
APERTUS_BASE_URL=https://api.swisscom.com/products/swiss-ai-weeks/apertus-1.5-70b/v1
APERTUS_MODEL=swiss-ai/Apertus-v1.5-70B

# ---- 3) Azure OpenAI (only if the organisers give you one) ---------------------------------------------
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# ---- 4) Claude / Anthropic (needs: pip install anthropic) --------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# ---- 5) Local model (Ollama / LM Studio) --------------------------------------------------------------------
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_MODEL=

# ---- Embeddings (optional). Apertus has none, so OpenAI is used automatically if OPENAI_API_KEY is set. ----
EMBED_MODEL=text-embedding-3-small

# ---- Cost per 1M tokens in USD (drives the "cost per ticket" number) ----------------------------------------
PRICE_IN_PER_1M=0.40
PRICE_OUT_PER_1M=1.60

# ---- 1 = never call any LLM (deterministic rules only) --------------------------------------------------------
TRIAGE_OFFLINE=0
