@baseUrl = https://api.typesafe.ai
@apiKey = {{$dotenv JEV_API_KEY}}

### Jev
POST {{baseUrl}}/v1/systemone
Authorization: Bearer {{apiKey}}
Content-Type: application/json

{
  "model": "jev-latest",
  "state": {
    //Usage: uncomment the case to test

    //service request description
    "description": "A user needs access to NAV Calculation to complete their daily tasks. This request is for standard role-based access and is aligned to the employee's business duties. Please validate the access profile and ensure the user receives the correct permissions in line with policy."
    
