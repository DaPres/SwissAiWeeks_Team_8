      "instructions": "Classify this incident.",
      "criteria": {
        "service_request": "Request for a new service or change in existing service",
        "incident": "Unplanned interruption or degradation of service",
        "unclear": "Unclear classification"
      }
    },
    "urgency": {
        "type": "choice",
      "instructions": "Assess the urgency of this incident using the following definitions:\nCritical: Immediate action required (prevent/fix regulatory breach, security compromise, or major outage). No workaround available.\nHigh: Rapid resolution needed within hours to avoid escalation. Workaround available but difficult/time-consuming.\nMedium: Important to fix soon; no immediate operational/regulatory threat. Easy workaround available.\nLow: Handled in normal workflow without urgent escalation.\nLowest: Routine/informational with no effect on operations or compliance.",
        "criteria": {
            "Lowest": "Lowest",
            "Low": "Low",
            "Medium": "Medium",
            "High": "High",
            "Highest": "Highest",
            "unclear": "Unclear"
        }
        },
    "impact": {
        "type": "choice",
      "instructions": "Assess the impact of this incident using the following definitions:\nMajor / Widespread: Full unavailability to critical IT services supporting key operations (> 2 hrs downtime).\nSignificant / Large: Partial unavailability of critical IT services, 1+ business entities affected, or financial counterparts affected.\nModerate / Limited: Full unavailability of non-critical IT services, or up to 1 business entity affected.\nMinor / Localized: Partial unavailability of non-critical IT services, or individuals affected.\nNo direct impact / Information: No direct operational impact; informational/maintenance without service degradation.",
        "criteria": {
            "Major / Widespread": "Full unavailability to critical IT services supporting key operations (> 2 hrs downtime)",
            "Significant / Large": "Partial unavailability of critical IT services, 1+ business entities affected, or financial counterparts affected",
            "Moderate / Limited": "Full unavailability of non-critical IT services, or up to 1 business entity affected",
            "Minor / Localized": "Partial unavailability of non-critical IT services, or individuals affected",
            "No direct impact / Information": "No direct operational impact; informational/maintenance without service degradation",
            "Unclear": "Impact is unclear"
        }
        },
    "priority": {
        "type": "choice",
      "instructions": "Calculate priority from urgency and impact using this matrix. Impact columns: Major / Widespread, Significant / Large, Moderate / Limited, Minor / Localized, No direct impact / Information.\nCritical urgency: Highest, Highest, High, Medium, Medium.\nHigh urgency: Highest, High, High, Medium, Low.\nMedium urgency: High, High, Medium, Low, Low.\nLow urgency: Medium, Medium, Low, Low, Lowest.\nLowest urgency: Medium, Low, Low, Lowest, Lowest.",
        "criteria": {
        "Lowest": "Low urgency with No direct impact / Information, or Lowest urgency with Moderate / Limited or lower impact",
        "Low": "High urgency with No direct impact / Information, Medium urgency with Minor / Localized or No direct impact / Information, Low urgency with Moderate / Limited or Minor / Localized, or Lowest urgency with Significant / Large or Moderate / Limited",
        "Medium": "Critical urgency with Minor / Localized or No direct impact / Information, High urgency with Minor / Localized, Low urgency with Major / Widespread or Significant / Large, or Lowest urgency with Major / Widespread",
        "High": "Critical urgency with Moderate / Limited, Medium urgency with Major / Widespread or Significant / Large, or High urgency with Significant / Large or Moderate / Limited",
        "Highest": "Critical urgency with Major / Widespread or Significant / Large, or High urgency with Major / Widespread",
        "Unclear": "Priority is unclear"
        }
        },
