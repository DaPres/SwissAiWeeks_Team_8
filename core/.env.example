# Copy this file to `.env` and fill in values. `.env` is git-ignored; never commit real keys.

# --- LLM providers (tried in this order by app/agent/llm_client.py) ---
SWISSCOM_APERTUS_API_KEY=      # from The Keymaker (keymaker.ai-weeks.ch), select Swisscom. Bearer token expires ~60 min: re-issue and paste again.
OPENAI_API_KEY=                # from The Keymaker, redeemed at platform.openai.com
HF_TOKEN=                      # for Public AI fallback via Hugging Face router (huggingface.co/settings/tokens)

# --- Other hackathon services (not wired into the agent yet) ---
ELEVENLABS_API_KEY=            # from Discord #coupon-codes bot
SUPERTEXT_API_KEY=             # from The Keymaker, select Supertext
SRGSSR_CONSUMER_KEY=           # from the SRG SSR developer portal
SRGSSR_CONSUMER_SECRET=        # from the SRG SSR developer portal

# --- Per-task provider routing (see docs/provider_capabilities.md for the measurements) ---
# The named provider goes FIRST; the others remain as fallbacks. Setting all four to
# swisscom-apertus gives an all-Swiss deployment. Values: swisscom-apertus | openai |
# publicai-hf | ollama-local
TASK_CLASSIFY_PROVIDER=swisscom-apertus
TASK_EXTRACT_PROVIDER=swisscom-apertus
TASK_AGENT_PROVIDER=swisscom-apertus
TASK_DRAFT_PROVIDER=swisscom-apertus

# --- Optional overrides (defaults shown; leave commented unless you need to change them) ---
# RATE_LIMIT_ATTEMPTS=3               # Apertus returns 429 EXPIRED_QUOTA on rapid calls
# RATE_LIMIT_BASE_SECONDS=2           # exponential backoff base before falling to the next provider
# LLM_CACHE=1                         # disk cache of model results, keyed by ticket id + task
# LLM_CACHE_DIR=data/llm_cache
# LLM_STRICT_REDACTION=0              # 1 = raise instead of redacting if PII reaches the model layer
# APERTUS_BASE_URL=https://api.swisscom.com/products/swiss-ai-weeks/apertus-1.5-70b/v1
# APERTUS_MODEL=swiss-ai/Apertus-v1.5-70B
# OPENAI_MODEL=gpt-4o-mini
# PUBLICAI_MODEL=swiss-ai/Apertus-70B-Instruct-2509:publicai   # verify the exact id on huggingface.co; must end in :publicai
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2:3b
# OLLAMA_FALLBACK_MODE=always         # DEMO DEFAULT: Ollama catches any cloud failure, so the stage demo never 503s. Set to offline_only to use it only when there is no internet.
# RELATED_WINDOW_HOURS=4              # duplicate/alert correlation window (ours, not an organiser rule)
# LLM_TIMEOUT_SECONDS=30
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# API_URL=http://localhost:8000       # used by the Streamlit UI
