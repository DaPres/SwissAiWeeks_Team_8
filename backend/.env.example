# Azure AI Foundry — OpenAI v1-compatible endpoint of your Foundry resource
AZURE_FOUNDRY_ENDPOINT=https://ai-weeks.services.ai.azure.com/openai/v1/
# Shared team key (Foundry portal > Overview). Leave empty to use Entra ID instead (needs the "Azure AI User" role).
AZURE_FOUNDRY_API_KEY=

# Deployment names in your Foundry project
CHAT_DEPLOYMENT=gpt-5.6-terra
VISION_DEPLOYMENT=            # defaults to CHAT_DEPLOYMENT (must accept image input)
EMBEDDING_DEPLOYMENT=text-embedding-3-small

# LLM_MODE=mock               # force offline mode (keyword embeddings, heuristic triage)
# TOP_K=6
# DUPLICATE_THRESHOLD=0.82    # cosine similarity for "already reported" open tickets
