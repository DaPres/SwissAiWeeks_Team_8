# Azure AI Foundry — OpenAI v1-compatible endpoint of your Foundry resource
AZURE_FOUNDRY_ENDPOINT=https://ai-weeks.services.ai.azure.com/openai/v1/
# Shared team key (Foundry portal > Overview). Leave empty to use Entra ID instead (needs the "Foundry User" role).
AZURE_FOUNDRY_API_KEY=

# Deployment names in your Foundry project
CHAT_DEPLOYMENT=gpt-5.6-terra
VISION_DEPLOYMENT=            # defaults to CHAT_DEPLOYMENT (must accept image input)
EMBEDDING_DEPLOYMENT=text-embedding-3-small

# OpenAI API — enabled when a key is set
OPENAI_API_KEY=
# OPENAI_CHAT_MODEL=gpt-6-luna
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small   # only used when Foundry is not configured

# Swisscom Apertus (https://zh.ai-weeks.ch/tools/swisscom-hacker-guide) — enabled when a key is set.
# Text only: screenshots are described by Foundry/OpenAI, embeddings always come from Foundry/OpenAI.
APERTUS_API_KEY=
# APERTUS_BASE_URL=https://api.swisscom.com/products/swiss-ai-weeks/apertus-1.5-70b/v1
# APERTUS_MODEL=swiss-ai/Apertus-v1.5-70B
# APERTUS_MAX_CONCURRENCY=2   # calls in flight at once (rate limit); 0 = unlimited
# LLM_RATE_LIMIT_RETRIES=6    # backoff retries on HTTP 429 (2s doubling up to 60s, or Retry-After)

# LLM_MODE=foundry            # default provider: foundry | openai | apertus; "mock" forces offline mode
# TOP_K=6
# DUPLICATE_THRESHOLD=0.82    # cosine similarity for "already reported" open tickets

# Intake — shared by Aspire's intake-backend resource (server-side only)
JEV_API_KEY=
JEV_MODEL=jev-latest
OPENAI_MODEL=gpt-4.1-mini
