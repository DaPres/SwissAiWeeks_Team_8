# =====================================================================================
# TriageMate configuration.  Copy this file to  .env  (same folder) and fill in ONE provider block.
# .env is git-ignored. With no key the system runs fully OFFLINE (rules + retrieval) - nothing breaks.
# =====================================================================================

# ---- 1) OpenAI (USD 50 credit) -- classification / extraction ------------------------------------
LLM_PROVIDER=openai
LLM_API_KEY=PASTE_OPENAI_KEY_HERE
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
# optional: cheaper/faster model for classification, stronger one for drafting
LLM_MODEL_CLASSIFY=
LLM_MODEL_DRAFT=

# ---- 2) Swisscom Apertus (Swiss AI Platform, OpenAI-compatible) -----------------------------------
# LLM_PROVIDER=apertus
# LLM_API_KEY=PASTE_SWISSCOM_KEY_HERE
# LLM_BASE_URL=PASTE_BASE_URL_FROM_THE_EVENT_PAGE      # must end in /v1 (the URL that serves /chat/completions)
# LLM_MODEL=PASTE_MODEL_NAME_FROM_THE_EVENT_PAGE       # e.g. the Apertus instruct model id they list

# ---- 3) Azure OpenAI ----------------------------------------------------------------------------
# LLM_PROVIDER=azure
# LLM_API_KEY=PASTE_AZURE_KEY_HERE
# AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=YOUR_DEPLOYMENT_NAME
# AZURE_OPENAI_API_VERSION=2024-10-21

# ---- 4) Claude (Anthropic) -- needs `pip install anthropic` ---------------------------------------
# LLM_PROVIDER=anthropic
# LLM_API_KEY=PASTE_ANTHROPIC_KEY_HERE
# LLM_MODEL=claude-opus-5            # or claude-sonnet-5 for lower cost / latency

# ---- 5) Local model (Ollama / LM Studio, OpenAI-compatible) ---------------------------------------
# LLM_PROVIDER=local
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1

# ---- Embeddings (optional; without them a local TF-IDF/LSA model is used) ---------------------------
# Multilingual embeddings help German/French tickets match the English KB.
# EMBED_BASE_URL=                      # blank = same base URL as above
# EMBED_API_KEY=                       # blank = same key as above
EMBED_MODEL=text-embedding-3-small

# ---- Cost accounting (USD per 1M tokens) -> "cost per ticket" metric. Set to your model's real rates.
PRICE_IN_PER_1M=0.40
PRICE_OUT_PER_1M=1.60

# ---- Runtime ------------------------------------------------------------------------------------
TRIAGE_OFFLINE=0                       # 1 = never call an LLM even if a key is present
CONFIDENCE_FLOOR=0.60
DB_PATH=outputs/triagemate.db
