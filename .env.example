# Copy to .env and fill in. The system runs fully OFFLINE (deterministic rules + retrieval)
# when no key is configured; every LLM step has a deterministic fallback.

# ---- Provider: any OpenAI-compatible chat-completions endpoint --------------------------
# LLM_PROVIDER: openai | azure | apertus | anthropic | local | none
LLM_PROVIDER=none
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
# Optional: a different (usually cheaper/faster) model for classification vs drafting.
LLM_MODEL_CLASSIFY=
LLM_MODEL_DRAFT=

# Azure OpenAI only (LLM_PROVIDER=azure)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=

# Embeddings (optional; falls back to a local TF-IDF/LSA model if empty)
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=text-embedding-3-small

# ---- Cost accounting (USD per 1M tokens; used for the "cost per ticket" metric) ---------
PRICE_IN_PER_1M=0.40
PRICE_OUT_PER_1M=1.60

# ---- Runtime ----------------------------------------------------------------------------
TRIAGE_OFFLINE=0          # 1 = never call an LLM, even if a key is present
CONFIDENCE_FLOOR=0.60
DB_PATH=outputs/triagemate.db
