# Copy this file to `.env` and fill in values. `.env` is git-ignored; never commit real keys.

# --- LLM providers (tried in this order by app/agent/llm_client.py) ---
SWISSCOM_APERTUS_API_KEY=      # from The Keymaker (keymaker.ai-weeks.ch), select Swisscom. Bearer token expires ~60 min: re-issue and paste again.
OPENAI_API_KEY=                # from The Keymaker, redeemed at platform.openai.com
HF_TOKEN=                      # for Public AI fallback via Hugging Face router (huggingface.co/settings/tokens)

# --- Other hackathon services (not wired into the agent yet) ---
ELEVENLABS_API_KEY=            # from Discord #coupon-codes bot
SUPERTEXT_API_KEY=             # from The Keymaker, select Supertext
SRGSSR_CONSUMER_KEY=           # from the SRG SSR developer portal
SRGSSR_CONSUMER_SECRET=        # from the SRG SSR developer portal

# --- Optional overrides (defaults shown; leave commented unless you need to change them) ---
# APERTUS_BASE_URL=https://api.swisscom.com/products/swiss-ai-weeks/apertus-1.5-70b/v1
# APERTUS_MODEL=swiss-ai/Apertus-v1.5-70B
# OPENAI_MODEL=gpt-4o-mini
# PUBLICAI_MODEL=swiss-ai/Apertus-70B-Instruct-2509:publicai   # verify the exact id on huggingface.co; must end in :publicai
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2:3b
# OLLAMA_FALLBACK_MODE=offline_only   # offline_only = use Ollama only when there is no internet; always = use it whenever the cloud providers fail
# LLM_TIMEOUT_SECONDS=30
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# API_URL=http://localhost:8000       # used by the Streamlit UI
